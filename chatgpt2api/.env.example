# Copy to .env by running: sh scripts/setup.sh
# Never commit .env, upstream session data or account tokens.
CHATGPT2API_IMAGE=ghcr.io/yukkcat/chatgpt2api:v3.2.4
CHATGPT2API_AUTH_KEY=REPLACE_WITH_RANDOM_SECRET
CHATGPT2API_PORT=3000
CHATGPT2API_THREAD_TOKENS=8
CHATGPT2API_BASE_URL=
DATABASE_URL=
TZ=Asia/Taipei

# Only needed for --profile public. Add an A record pointing to your VPS first.
API_DOMAIN=chatgpt2api.monsterport.com
